+/* Keep the received signed attributes, not a sorted re-encoding. The signature
+ * covers their original encoding with the implicit [0] tag replaced by SET OF.
+ * All temporary decodes own their bytes; no pointers into the input survive.
+ */
+static BOOL CSignedMsgData_SaveAuthenticatedAttributes(CSignedMsgData *msg_data,
+ const CRYPT_DER_BLOB *blob)
+{
+    CRYPT_SEQUENCE_OF_ANY *fields = NULL, *signers = NULL, *signer = NULL;
+    CRYPT_DER_BLOB *encoded;
+    DWORD i, size;
+    BOOL ret = FALSE;
+
+    if (!msg_data->info->cSignerInfo) return TRUE;
+    if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_SEQUENCE_OF_ANY,
+     blob->pbData, blob->cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &fields, &size))
+        goto done;
+    if (!fields->cValue) goto malformed;
+    encoded = &fields->rgValue[fields->cValue - 1];
+    if (encoded->cbData < 2 || encoded->pbData[0] != 0x31) goto malformed;
+
+    /* X509_SEQUENCE_OF_ANY expects a SEQUENCE. Change only our temporary copy
+     * of the signerInfos SET tag; its elements and ordering are unchanged. */
+    encoded->pbData[0] = 0x30;
+    if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_SEQUENCE_OF_ANY,
+     encoded->pbData, encoded->cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &signers, &size))
+        goto done;
+    if (signers->cValue != msg_data->info->cSignerInfo) goto malformed;
+    for (i = 0; i < signers->cValue; ++i)
+    {
+        if (!msg_data->info->rgSignerInfo[i].AuthAttrs.cAttr) continue;
+        encoded = &signers->rgValue[i];
+        if (!CryptDecodeObjectEx(X509_ASN_ENCODING, X509_SEQUENCE_OF_ANY,
+         encoded->pbData, encoded->cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &signer, &size))
+            goto done;
+        /* SignerInfo: version, signer identifier, digest algorithm, [0] attrs. */
+        if (signer->cValue < 4) goto malformed;
+        encoded = &signer->rgValue[3];
+        if (encoded->cbData < 2 || encoded->pbData[0] != 0xa0) goto malformed;
+        if (!CRYPT_ConstructBlob(&msg_data->signerHandles[i].encodedAuthAttrs, encoded))
+            goto done;
+        msg_data->signerHandles[i].encodedAuthAttrs.pbData[0] = 0x31;
+        LocalFree(signer);
+        signer = NULL;
+    }
+    ret = TRUE;
+    goto done;
+malformed:
+    SetLastError(CRYPT_E_ASN1_CORRUPT);
+done:
+    LocalFree(signer);
+    LocalFree(signers);
+    LocalFree(fields);
+    return ret;
+}
